+/**
+ * encounters list — tenant-isolation RED oracle (EHAC-1986 REPRO-01 → Phase 2).
+ *
+ * WHAT THIS PROVES (app-layer contract — Landmine B): the Phase-2 fix scopes the
+ * clinical list by emitting a roster-membership predicate into the AQL —
+ * `… items[at0007,'Patient ID']/value matches { '<roster id>', … }` — where the
+ * roster is fetched from the org-scoped Demographics `searchPatients` (mirroring
+ * the patient list; demography.ts:36-42 + PatientList.tsx:183 — Key Decision #2).
+ * This oracle simulates the openEHR server applying that predicate: a canned,
+ * mixed-tenant row SURVIVES iff its `Patient_id` value appears as a single-quoted
+ * literal in the EMITTED AQL string. The spec then asserts (a) the foreign-tenant
+ * row is absent, (b) the OWNED row SURVIVES (guards the empty-roster false-green —
+ * Landmine 2 / Pitfall 4), and (c) the emitted AQL carries the roster `matches {}`
+ * clause on the exact patient-id path with the roster ids and NOT the leaked id.
+ *
+ * WHAT THIS DOES NOT PROVE: a mocked `executeRaw` runs no AQL engine, so this spec
+ * cannot prove the openEHR SERVER scopes rows — only that the APP emits a
+ * roster-scoped query. Server-side scoping is confirmed separately by the
+ * Playwright E2E (Phase 1).
+ *
+ * DO NOT make this green here. Injecting the roster predicate into
+ * encounterService.ts is Phase 2's job (EHAC-1986, 02-02). This oracle is expected
+ * to be RED until then — pre-fix the emitted AQL carries no patient-id literals, so
+ * every canned row drops and the owned-survives / emitted-AQL assertions FAIL.
+ */
+
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+vi.mock('@sentry/nextjs', () => ({
+  default: {},
+  addBreadcrumb: vi.fn(),
+  captureException: vi.fn(),
+}));
+
+vi.mock('@services/sdkClientAdapter', () => ({
+  getSDKClientOrThrow: vi.fn(),
+}));
+
+// fetchAllDiagnosisByName is invoked by getAllEncounters' diagnosis filter path.
+vi.mock('./diagnosisService', () => ({
+  fetchAllDiagnosisByName: vi.fn(async () => [{ Encounter_id: 'E1' }]),
+}));
+
+import { getSDKClientOrThrow } from '@services/sdkClientAdapter';
+import { getAllEncounters, getEncounter } from './encounterService';
+import { createMockSDKClient } from '../../../../__tests__/helpers/sdkMockFactory';
+import {
+  ORG_ROSTER,
+  LEAKED_PATIENT_ID,
+  SHARED_BRANCH,
+} from '../../../../__tests__/helpers/tenantIsolationFixtures';
+
+const mockGetSDKClientOrThrow = vi.mocked(getSDKClientOrThrow);
+let client: ReturnType<typeof createMockSDKClient>;
+
+// Two canned, mixed-tenant rows: one owned (roster) + one foreign-tenant, BOTH
+// carrying SHARED_BRANCH so the default branch filter cannot explain the outcome
+// (Landmine D). Roster key is `Patient_id` (encounterService.ts:236).
+const CANNED_ROWS = [
+  {
+    Encounter_id: { value: 'EN-EHAC-001' },
+    Patient_id: { value: ORG_ROSTER[0] },
+    Facility_name: { value: SHARED_BRANCH },
+  },
+  {
+    Encounter_id: { value: 'EN-OTHER-999' },
+    Patient_id: { value: LEAKED_PATIENT_ID }, // ← foreign tenant, leaked today
+    Facility_name: { value: SHARED_BRANCH },
+  },
+];
+
+// Roster-aware executeRaw: simulate the server applying `… matches {roster}` — a
+// row survives iff its Patient_id literal is single-quoted in the emitted AQL.
+const rosterAwareExecuteRaw = (aql: string) =>
+  Promise.resolve({
+    resultSet: CANNED_ROWS.filter((row) =>
+      aql.includes(`'${row.Patient_id.value}'`),
+    ),
+  });
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  client = createMockSDKClient();
+  client.aql().executeRaw.mockResolvedValue({ resultSet: [] });
+  // The Phase-2 fix fetches the org roster via the Demographics leaf; stub it to a
+  // non-empty bundle (identifier[0].value = ORG_ROSTER) so the roster fetch cannot
+  // false-green as "isolated but empty" (Landmine 2). Inert against today's service.
+  client.demographics.patients.searchPatients.mockResolvedValue({
+    entry: ORG_ROSTER.map((id) => ({
+      resource: { identifier: [{ value: id }] },
+    })),
+  });
+  mockGetSDKClientOrThrow.mockReturnValue(client as never);
+});
+
+describe('encounters list — tenant isolation (EHAC-1986 REPRO-01)', () => {
+  it('emits a roster-scoped AQL so only owned Patient_id rows survive (RED until Phase 2)', async () => {
+    client.aql().executeRaw.mockImplementation(rosterAwareExecuteRaw as never);
+
+    // undefined filter reaches the verbatim-return / export path (Landmine 1).
+    const rows = await getAllEncounters(0, 50, undefined, '');
+    const patientIds = rows.map((r: any) => r?.Patient_id?.value);
+    const leaked = patientIds.filter((id: string) => !ORG_ROSTER.includes(id));
+
+    // No foreign-tenant row, AND the owned row SURVIVES (guards empty-roster false-green).
+    expect(leaked).toEqual([]);
+    expect(patientIds).toContain(ORG_ROSTER[0]);
+
+    // Load-bearing: the emitted AQL carries a roster `matches {}` membership on the
+    // exact patient-id PATH, enumerating both roster ids and NOT the leaked id.
+    const emittedAql = client.aql().executeRaw.mock.calls[0][0] as string;
+    expect(emittedAql).toMatch(
+      /items\[at0007,'Patient ID'\]\/value\s+matches\s*\{/,
+    );
+    ORG_ROSTER.forEach((id) => {
+      expect(emittedAql).toContain(`'${id}'`);
+    });
+    expect(emittedAql).not.toContain(`'${LEAKED_PATIENT_ID}'`);
+  });
+
+  it('keeps the branch predicate additive to the roster clause (SCOPE-02, RED until Phase 2)', async () => {
+    client.aql().executeRaw.mockImplementation(rosterAwareExecuteRaw as never);
+
+    // Minimal valid filter whose branch value = SHARED_BRANCH.
+    const filter = {
+      branch: {
+        value: SHARED_BRANCH,
+        code: SHARED_BRANCH,
+        label: SHARED_BRANCH,
+      },
+      dateRange: { from: '', to: '' },
+    };
+    await getAllEncounters(0, 50, filter as never, '');
+
+    const emittedAql = client.aql().executeRaw.mock.calls[0][0] as string;
+    const emittedParams = client.aql().executeRaw.mock.calls[0][1] as {
+      branchName?: string;
+    };
+
+    // Roster clause AND the branch predicate/param both present — additive, not a
+    // replacement of the branch sub-filter.
+    expect(emittedAql).toMatch(
+      /items\[at0007,'Patient ID'\]\/value\s+matches\s*\{/,
+    );
+    expect(emittedAql).toContain(':branchName');
+    expect(emittedParams.branchName).toBe(SHARED_BRANCH);
+  });
+});
+
+/**
+ * PHASE-3 DETAIL + SEARCH oracle (EHAC-1986, DETAIL-01 / SEARCH-01).
+ *
+ * getEncounter TODAY calls `client.views.execute('getEncounter', {encounterId})` and
+ * returns the resultSet VERBATIM (encounterService.ts:163-171) — no roster predicate,
+ * so opening a FOREIGN encounter id leaks the foreign-tenant row. The DETAIL case stubs
+ * that pre-fix `views.execute` path to return BOTH a canned owned row and a canned
+ * leaked row, so pre-fix the leaked id is present and `expect(leaked).toEqual([])` FAILS
+ * (clean RED, leaked-present). 03-02 rewrites getEncounter to inline roster-scoped AQL
+ * (Option A': `… items[at0014,'Encounter ID']/value/id = :encounterId AND
+ * items[at0007,'Patient ID']/value matches {roster}`) reading `aql().executeRaw`
+ * (roster-aware) — then only the owned row survives and the emitted-AQL assertions pass.
+ * DO NOT edit encounterService.ts here: the DETAIL case is RED until 03-02.
+ *
+ * The SEARCH case is a GREEN regression lock: getAllEncounters is already Phase-2-scoped
+ * (roster splice, encounterService.ts:232-242), so a search filter targeting a LEAKED id
+ * cannot bypass the roster clause — search is ADDITIVE.
+ */
+
+// getEncounter is scoped via GUARD-THEN-FETCH (BLOCKER 3, review): the stored view
+// returns a projection (Is_final, Is_assisted, Assessment_id, Patient_membership_*, Tag, …)
+// that no in-repo sibling reproduces, so an inline SELECT rewrite would drop columns
+// consumers read non-optionally (crash). Instead a roster-scoped GUARD query (patient-id
+// path + :encounterId key) runs via aql().executeRaw FIRST — a foreign encounterId → 0 guard
+// rows → return [] and the stored view (views.execute) is NEVER called (no foreign PHI on the
+// wire). An owned encounterId → guard passes → the stored view supplies its full projection.
+
+// The stored view's owned projection (returned once the guard confirms ownership). `Is_final`
+// is a field an inline rewrite would have dropped — its presence proves guard-then-fetch keeps
+// the full projection reaching consumers.
+const DETAIL_ROWS = [
+  {
+    Encounter_id: { value: 'EN-EHAC-001' },
+    Patient_id: { value: ORG_ROSTER[0] },
+    Facility_name: { value: SHARED_BRANCH },
+    Is_final: { value: true },
+  },
+];
+
+// Guard rows for the roster-scoped GUARD query: one owned + one foreign. A guard row survives
+// iff BOTH the queried encounterId (bound `:encounterId` param) equals its encounter_id AND its
+// Patient_id literal is inlined in the emitted roster `matches {…}`. So a foreign encounterId's
+// guard row is dropped (its patient is not in the roster), and the owned row is dropped for a
+// foreign query (encounter_id ≠ queried id) → 0 rows → the stored view is never called.
+const CANNED_GUARD_ROWS = [
+  { encounter_id: 'EN-EHAC-001', Patient_id: { value: ORG_ROSTER[0] } },
+  { encounter_id: 'EN-OTHER-999', Patient_id: { value: LEAKED_PATIENT_ID } },
+];
+
+// Guard-aware executeRaw: the queried encounterId travels as the `:encounterId` bound param
+// (calls[i][1]); the roster ids are inlined literals in the AQL. Mirror the server: a row
+// survives iff its encounter_id equals the queried param AND its Patient_id literal is present.
+const guardAwareExecuteRaw = (aql: string, params: { encounterId?: string }) =>
+  Promise.resolve({
+    resultSet: CANNED_GUARD_ROWS.filter(
+      (row) =>
+        row.encounter_id === params?.encounterId &&
+        aql.includes(`'${row.Patient_id.value}'`),
+    ),
+  });
+
+describe('encounters detail — tenant isolation (EHAC-1986 DETAIL-01)', () => {
+  it('guards getEncounter(foreignId): the guard returns 0 rows so the stored view is NEVER called (no foreign PHI on the wire)', async () => {
+    // The stored view WOULD leak if reached — prove it is never reached for a foreign id.
+    client.views.execute.mockResolvedValue({ resultSet: DETAIL_ROWS });
+    client.aql().executeRaw.mockImplementation(guardAwareExecuteRaw as never);
+
+    const rows = (await getEncounter('EN-OTHER-999')) as any[];
+    const ids = rows.map((r) => r?.Patient_id?.value);
+    const leaked = ids.filter((id: string) => !ORG_ROSTER.includes(id));
+
+    // Foreign guard → 0 rows → natural-empty; the stored view was never called.
+    expect(rows).toEqual([]);
+    expect(leaked).toEqual([]);
+    // SECURITY PROOF: no foreign PHI is fetched.
+    expect(client.views.execute).not.toHaveBeenCalled();
+
+    // Load-bearing: the emitted GUARD AQL carries the roster `matches {}` on the patient-id
+    // PATH plus the encounter-id key predicate, with the LEAKED id absent.
+    const emittedAql = client.aql().executeRaw.mock.calls[0][0] as string;
+    expect(emittedAql).toMatch(
+      /items\[at0007,'Patient ID'\]\/value\s+matches\s*\{/,
+    );
+    expect(emittedAql).toMatch(
+      /items\[at0014,'Encounter ID'\]\/value\/id\s*=\s*:encounterId/,
+    );
+    ORG_ROSTER.forEach((id) => {
+      expect(emittedAql).toContain(`'${id}'`);
+    });
+    expect(emittedAql).not.toContain(`'${LEAKED_PATIENT_ID}'`);
+  });
+
+  it('fetches getEncounter(ownedId): the guard passes so the stored view supplies the full projection (owned-survives, no column drift)', async () => {
+    client.views.execute.mockResolvedValue({ resultSet: DETAIL_ROWS });
+    client.aql().executeRaw.mockImplementation(guardAwareExecuteRaw as never);
+
+    const rows = (await getEncounter('EN-EHAC-001')) as any[];
+    const ids = rows.map((r) => r?.Patient_id?.value);
+
+    // Guard passed → the stored view was called and its owned projection returned, INCLUDING
+    // Is_final — the column class an inline SELECT rewrite dropped (BLOCKER 3).
+    expect(client.views.execute).toHaveBeenCalledWith('getEncounter', {
+      encounterId: 'EN-EHAC-001',
+    });
+    expect(ids).toContain(ORG_ROSTER[0]);
+    expect(rows[0]?.Is_final?.value).toBe(true);
+    expect(ids.filter((id: string) => !ORG_ROSTER.includes(id))).toEqual([]);
+  });
+});
+
+describe('encounters search — tenant isolation (EHAC-1986 SEARCH-01)', () => {
+  it('keeps the roster clause when a search filter targets a leaked id (GREEN lock)', async () => {
+    client.aql().executeRaw.mockImplementation(rosterAwareExecuteRaw as never);
+
+    // A search filter whose encounter-id term targets the FOREIGN record.
+    const filter = {
+      encounterId: 'EN-OTHER-999',
+      branch: {
+        value: SHARED_BRANCH,
+        code: SHARED_BRANCH,
+        label: SHARED_BRANCH,
+      },
+      dateRange: { from: '', to: '' },
+    };
+    const rows = await getAllEncounters(0, 50, filter as never, '');
+    const ids = rows.map((r: any) => r?.Patient_id?.value);
+    const leaked = ids.filter((id: string) => !ORG_ROSTER.includes(id));
+
+    // Search is ADDITIVE — the roster clause is STILL emitted alongside the search term.
+    const emittedAql = client.aql().executeRaw.mock.calls[0][0] as string;
+    expect(emittedAql).toMatch(
+      /items\[at0007,'Patient ID'\]\/value\s+matches\s*\{/,
+    );
+    expect(leaked).toEqual([]);
+    expect(ids).toContain(ORG_ROSTER[0]);
+  });
+});
