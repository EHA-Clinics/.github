+    response?: { status?: number };
+    constructor(message?: string) {
+      super(message);
+      this.name = 'AxiosError';
+    }
+  }
+  const instance = {
+    get: vi.fn(),
+    post: vi.fn(),
+    put: vi.fn(),
+    delete: vi.fn(),
+    interceptors: {
+      request: { use: vi.fn() },
+      response: { use: vi.fn() },
+    },
+  };
+  const create = vi.fn(() => instance);
+  return {
+    default: { isAxiosError, create, AxiosError },
+    isAxiosError,
+    create,
+    AxiosError,
+  };
