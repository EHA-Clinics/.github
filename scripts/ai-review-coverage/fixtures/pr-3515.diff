+/**
+ * Shared synthetic tenant-isolation fixtures (EHAC-1986 REPRO-01).
+ *
+ * A single, dependency-free, SYNTHETIC roster + mixed-tenant sentinel set imported
+ * by the three clinical-list `*.isolation.test.ts` RED specs (encounters, lab tests,
+ * prescriptions). Authored as a shareable helper so adr-008 EHAC-1796 can import it
+ * rather than duplicate a second drifting isolation harness (Key Decision #5).
+ *
+ * SECURITY (ASVS V7): every identifier here is SYNTHETIC — no real PHI ever crosses
+ * into a committed test artifact. Owned patient ids use the `HP-EHAC-*` namespace;
+ * the leaked (foreign-tenant) id uses `HP-OTHER-*`; the leaked prescriptions name is
+ * a collision-proof `LEAKED_`-prefixed sentinel.
+ *
+ * Why a sentinel NAME as well as a sentinel ID: the prescriptions report SELECT has
+ * NO `Patient_id` column (Landmine C), so its oracle must key on the non-unique
+ * `Patient_name` column. A common/shared name would false-green the leak, so the
+ * leaked name is a UUID-suffixed `LEAKED_` sentinel provably disjoint from every
+ * roster name (Review Item 2).
+ */
+
+/** Two synthetic patient ids owned by the caller org (Test-Admin EHAClinics' roster). */
+export const ORG_ROSTER: string[] = ['HP-EHAC-001', 'HP-EHAC-002'];
+
+/**
+ * The two matching synthetic patient NAMES. Plain synthetic names carrying NO
+ * `LEAKED_` prefix, so the LEAKED_PATIENT_NAME sentinel below stays provably disjoint
+ * (used by the prescriptions spec, which has no Patient_id column to key on).
+ */
+export const ORG_ROSTER_NAMES: string[] = [
+  'Synthetic Roster One',
+  'Synthetic Roster Two',
+];
+
+/** A synthetic OTHER-tenant patient id that is NOT a member of ORG_ROSTER (the leaked id). */
+export const LEAKED_PATIENT_ID = 'HP-OTHER-777';
+
+/**
+ * Collision-proof leaked patient NAME: a `LEAKED_`-prefixed sentinel with a hardcoded
+ * UUID suffix, guaranteed disjoint from ORG_ROSTER_NAMES. This makes the LEAK (not an
+ * incidental name collision) the reason the prescriptions `Patient_name` oracle fails.
+ */
+export const LEAKED_PATIENT_NAME =
+  'LEAKED_7f3ab21c-4e6d-4c9a-9b2e-0a1f5d3c8e42';
+
+/**
+ * One synthetic branch/Facility value carried by BOTH the owned and the leaked rows,
+ * so the lists' default branch filter cannot explain the leak (Landmine D).
+ */
+export const SHARED_BRANCH = 'SYNTH-BRANCH-01';
