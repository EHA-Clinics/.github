+/**
+ * Returns the caller org's active tenant id (the KC org slug set on the last
+ * session change), or null if the client has not been initialized yet.
+ *
+ * This is the synchronous accessor for the tenant/org identity the SDK client
+ * was initialized with. It exists so per-org caches (e.g. the tenant-roster
+ * cache in `tenantRoster.ts`, EHAC-1986) can key by the caller org and never
+ * serve one org's data to another. Returns null when indeterminate so callers
+ * can fail safe (skip the cache) rather than key under an ambiguous value.
+ */
+export function getSDKTenantId(): string | null {
+  return currentTenantId;
+}
