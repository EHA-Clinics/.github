index 0000000000..0327d9ae72
--- /dev/null
+++ b/apps/ehacare/frontend/src/common/services/tenantRoster.test.ts
@@ -0,0 +1,282 @@
+/**
+ * tenantRoster — shared org-roster primitive unit tests (EHAC-1986, 02-02 Task 1).
+ *
+ * Proves the fail-closed org-scoping primitive that the clinical-list reads inject
+ * as an additive AQL `matches {…}` predicate:
+ *  - getOrgPatientRoster('patient_id') extracts HP-* ids from the org-scoped
+ *    Demographics `searchPatients` bundle (mirrors the patient list; Key Decision #2),
+ *    fetches the COMPLETE roster (paging), de-dupes, and propagates fetch errors.
+ *  - getOrgPatientRoster('ehr_id') resolves the HP-* roster to openEHR ehr_ids via a
+ *    single cap-guarded mapping AQL; an empty/failed mapping fails CLOSED to [].
+ *  - a short-TTL per-org(+idType) cache avoids a per-request searchPatients round-trip
+ *    and NEVER serves one org's roster to another (review Item 3).
+ *  - buildRosterMatchClause renders a sanitized `path matches { '…' }` set; empty →
+ *    fail-closed `matches {''}`; over ROSTER_MATCH_CAP → RosterTooLargeError (review 1).
+ *  - escapeAqlLiteral is pinned to the SDK's sanitizeAQLParameter escape rules (review 4).
+ */
+
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+
+vi.mock('@sentry/nextjs', () => ({
+  default: {},
+  addBreadcrumb: vi.fn(),
+  captureException: vi.fn(),
+}));
+
+vi.mock('@services/sdkClientAdapter', () => ({
+  getSDKClientOrThrow: vi.fn(),
+  getSDKTenantId: vi.fn(() => 'org-A'),
+}));
+
+import * as sdkClientAdapter from '@services/sdkClientAdapter';
+import { createMockSDKClient } from 'src/__tests__/helpers/sdkMockFactory';
+import {
+  getOrgPatientRoster,
+  buildRosterMatchClause,
+  RosterTooLargeError,
+  RosterFetchError,
+  ROSTER_MATCH_CAP,
+  __resetRosterCacheForTests,
+} from './tenantRoster';
+
+const mockGetSDKClientOrThrow = vi.mocked(sdkClientAdapter.getSDKClientOrThrow);
+const mockGetSDKTenantId = vi.mocked(sdkClientAdapter.getSDKTenantId);
+let client: ReturnType<typeof createMockSDKClient>;
+
+const bundleOf = (ids: string[], total?: number) => ({
+  ...(total !== undefined ? { total } : {}),
+  entry: ids.map((id) => ({ resource: { identifier: [{ value: id }] } })),
+});
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  __resetRosterCacheForTests();
+  client = createMockSDKClient();
+  mockGetSDKClientOrThrow.mockReturnValue(client as never);
+  mockGetSDKTenantId.mockReturnValue('org-A');
+});
+
+describe('getOrgPatientRoster — patient_id (default)', () => {
+  it('extracts identifier[0].value (HP-*) from the searchPatients bundle', async () => {
+    client.demographics.patients.searchPatients.mockResolvedValue(
+      bundleOf(['HP-EHAC-001', 'HP-EHAC-002']),
+    );
+
+    const roster = await getOrgPatientRoster();
+
+    expect(roster).toEqual(['HP-EHAC-001', 'HP-EHAC-002']);
+    // org-scoped Demographics source, active patients (mirrors the patient list).
+    const args = client.demographics.patients.searchPatients.mock.calls[0][0];
+    expect(args).toMatchObject({ active: 'true' });
+  });
+
+  it('drops falsy ids and de-duplicates', async () => {
+    client.demographics.patients.searchPatients.mockResolvedValue({
+      entry: [
+        { resource: { identifier: [{ value: 'HP-EHAC-001' }] } },
+        { resource: { identifier: [{ value: '' }] } },
+        { resource: { identifier: [] } },
+        { resource: { identifier: [{ value: 'HP-EHAC-001' }] } }, // dup
+        { resource: { identifier: [{ value: 'HP-EHAC-002' }] } },
+      ],
+    });
+
+    expect(await getOrgPatientRoster()).toEqual(['HP-EHAC-001', 'HP-EHAC-002']);
+  });
+
+  it('fetches the COMPLETE roster across pages (never a silent partial)', async () => {
+    client.demographics.patients.searchPatients
+      .mockResolvedValueOnce(bundleOf(['HP-1', 'HP-2'], 4)) // total says more remain
+      .mockResolvedValueOnce(bundleOf(['HP-3', 'HP-4'], 4));
+
+    const roster = await getOrgPatientRoster();
+
+    expect(roster).toEqual(['HP-1', 'HP-2', 'HP-3', 'HP-4']);
+    expect(client.demographics.patients.searchPatients).toHaveBeenCalledTimes(
+      2,
+    );
+  });
+
+  it('propagates a searchPatients error as a distinguishable RosterFetchError, preserving the cause (no silent empty roster; M9)', async () => {
+    const cause = new Error('demographics down');
+    client.demographics.patients.searchPatients.mockRejectedValue(cause);
+
+    // M9: the coupling to Demographics surfaces a DISTINGUISHABLE error (so on-call sees
+    // "roster/Demographics", not a generic EHR/AQL failure), while preserving the cause.
+    const err = await getOrgPatientRoster().catch((e) => e);
+    expect(err).toBeInstanceOf(RosterFetchError);
+    expect((err as RosterFetchError).cause).toBe(cause);
+  });
+});
+
+describe('getOrgPatientRoster — ehr_id mapping (review Item 2)', () => {
+  it('resolves the HP-* roster to distinct ehr_ids via the mapping AQL', async () => {
+    client.demographics.patients.searchPatients.mockResolvedValue(
+      bundleOf(['HP-EHAC-001', 'HP-EHAC-002']),
+    );
+    client.aql().executeRaw.mockResolvedValue({
+      resultSet: [
+        { Ehr_id: { value: 'ehr-1' } },
+        { Ehr_id: { value: 'ehr-2' } },
+        { Ehr_id: { value: 'ehr-1' } }, // dup
+      ],
+    });
+
+    const roster = await getOrgPatientRoster('ehr_id');
+
+    expect(roster).toEqual(['ehr-1', 'ehr-2']);
+    // the mapping AQL is cap-guarded and carries the HP-* roster as a matches set.
+    const aql = client.aql().executeRaw.mock.calls[0][0] as string;
+    expect(aql).toMatch(/matches\s*\{/);
+    expect(aql).toContain("'HP-EHAC-001'");
+    expect(aql).toContain("'HP-EHAC-002'");
+  });
+
+  it('fails CLOSED to [] when the mapping AQL errors (never an unscoped read)', async () => {
+    client.demographics.patients.searchPatients.mockResolvedValue(
+      bundleOf(['HP-EHAC-001']),
+    );
+    client.aql().executeRaw.mockRejectedValue(new Error('aql boom'));
+
+    expect(await getOrgPatientRoster('ehr_id')).toEqual([]);
+  });
+
+  it('returns [] for an empty mapping resultSet (0-patient → 0 rows downstream)', async () => {
+    client.demographics.patients.searchPatients.mockResolvedValue(
+      bundleOf(['HP-EHAC-001']),
+    );
+    client.aql().executeRaw.mockResolvedValue({ resultSet: [] });
+
+    expect(await getOrgPatientRoster('ehr_id')).toEqual([]);
+  });
+});
+
+describe('getOrgPatientRoster — per-org caching (review Item 3)', () => {
+  it('serves a repeat same-org call from cache (one searchPatients round-trip)', async () => {
+    client.demographics.patients.searchPatients.mockResolvedValue(
+      bundleOf(['HP-EHAC-001', 'HP-EHAC-002']),
+    );
+
+    const a = await getOrgPatientRoster();
+    const b = await getOrgPatientRoster();
+
+    expect(a).toEqual(b);
+    expect(client.demographics.patients.searchPatients).toHaveBeenCalledTimes(
+      1,
+    );
+  });
+
+  it('does NOT cache a fetch error (a later call retries; M9 wraps as RosterFetchError)', async () => {
+    client.demographics.patients.searchPatients
+      .mockRejectedValueOnce(new Error('transient'))
+      .mockResolvedValueOnce(bundleOf(['HP-EHAC-001']));
+
+    await expect(getOrgPatientRoster()).rejects.toBeInstanceOf(
+      RosterFetchError,
+    );
+    expect(await getOrgPatientRoster()).toEqual(['HP-EHAC-001']);
+    expect(client.demographics.patients.searchPatients).toHaveBeenCalledTimes(
+      2,
+    );
+  });
+
+  it('keys by org id so one org never receives another org roster', async () => {
+    client.demographics.patients.searchPatients
+      .mockResolvedValueOnce(bundleOf(['HP-A-1']))
+      .mockResolvedValueOnce(bundleOf(['HP-B-1']));
+
+    mockGetSDKTenantId.mockReturnValue('org-A');
+    const orgA = await getOrgPatientRoster();
+
+    mockGetSDKTenantId.mockReturnValue('org-B');
+    const orgB = await getOrgPatientRoster();
+
+    expect(orgA).toEqual(['HP-A-1']);
+    expect(orgB).toEqual(['HP-B-1']);
+    expect(client.demographics.patients.searchPatients).toHaveBeenCalledTimes(
+      2,
+    );
+  });
+
+  it('skips the cache when the org id is indeterminate (fetch fresh, no ambiguous key)', async () => {
+    mockGetSDKTenantId.mockReturnValue(null);
+    client.demographics.patients.searchPatients.mockResolvedValue(
+      bundleOf(['HP-EHAC-001']),
+    );
+
+    await getOrgPatientRoster();
+    await getOrgPatientRoster();
+
+    expect(client.demographics.patients.searchPatients).toHaveBeenCalledTimes(
+      2,
+    );
+  });
+});
+
+describe('buildRosterMatchClause', () => {
+  it('renders a sanitized matches set on the given path', () => {
+    expect(buildRosterMatchClause('somePath', ['HP-A', 'HP-B'])).toBe(
+      "somePath matches { 'HP-A','HP-B' }",
+    );
+  });
+
+  it("fails CLOSED to matches {''} for an empty roster (0 rows, never absent)", () => {
+    expect(buildRosterMatchClause('somePath', [])).toBe(
+      "somePath matches {''}",
+    );
+  });
+
+  it("escapes a single quote to '' (AQL-injection safe)", () => {
+    expect(buildRosterMatchClause('p', ["HP'X"])).toBe("p matches { 'HP''X' }");
+  });
+
+  it('throws RosterTooLargeError over ROSTER_MATCH_CAP (fail-closed refusal, never truncated)', () => {
+    const overCap = Array.from(
+      { length: ROSTER_MATCH_CAP + 1 },
+      (_, i) => `HP-${i}`,
+    );
+    expect(() => buildRosterMatchClause('p', overCap)).toThrow(
+      RosterTooLargeError,
+    );
+    // and it does NOT emit an unscoped/absent/truncated clause
+    let emitted: string | undefined;
+    try {
+      emitted = buildRosterMatchClause('p', overCap);
+    } catch {
+      emitted = undefined;
+    }
+    expect(emitted).toBeUndefined();
+  });
+
+  it('renders (does not throw) at exactly ROSTER_MATCH_CAP', () => {
+    const atCap = Array.from({ length: ROSTER_MATCH_CAP }, (_, i) => `HP-${i}`);
+    const clause = buildRosterMatchClause('p', atCap);
+    expect(clause.startsWith('p matches { ')).toBe(true);
+    expect(clause).toContain("'HP-0'");
+    expect(clause).toContain(`'HP-${ROSTER_MATCH_CAP - 1}'`);
+  });
+});
+
+describe('escapeAqlLiteral ↔ sanitizeAQLParameter parity (review Item 4)', () => {
+  // Expected outputs transcribed from libs/bettercare-sdk/src/core/utils/validation.ts:153-164
+  // (sanitizeAQLParameter): String(value), then replace ' → '', strip ';' and '--'.
+  // The deep SDK import is avoided to keep this spec side-effect-free (barrel/interceptor);
+  // any drift in the local escapeAqlLiteral mirror breaks these pinned expectations.
+  const cases: Array<[string, string]> = [
+    ['HP-EHAC-001', 'HP-EHAC-001'],
+    ["HP'X", "HP''X"],
+    ['HP;X', 'HPX'],
+    ['HP--X', 'HPX'],
+    ['', ''],
+  ];
+
+  it.each(cases)(
+    'escapes %j via the same rules as the SDK',
+    (input, expected) => {
+      // buildRosterMatchClause wraps each id as '<escaped>' — assert the escaped body.
+      expect(buildRosterMatchClause('p', [input])).toBe(
+        `p matches { '${expected}' }`,
+      );
+    },
+  );
+});
diff --git a/apps/ehacare/frontend/src/common/services/tenantRoster.ts b/apps/ehacare/frontend/src/common/services/tenantRoster.ts
new file mode 100644
index 0000000000..943b3f732c
--- /dev/null
+++ b/apps/ehacare/frontend/src/common/services/tenantRoster.ts
@@ -0,0 +1,353 @@
+/**
+ * tenantRoster — the single reusable org-scoping primitive for every clinical
+ * openEHR read (EHAC-1986, Phase 2). It bridges the org-scoped FHIR Demographics
+ * roster (the isolation source the patient list already trusts — Key Decision #2)
+ * onto the AQL clinical-list queries as an additive `… matches { '<id>', … }`
+ * membership predicate.
+ *
+ * `getOrgPatientRoster()` fetches the caller org's OWN patient roster from
+ * `client.demographics.patients.searchPatients` (the same org-scoped Demographics
+ * host + OAuth `organization` scope the patient list reads), mirroring the
+ * patient-list scoping rather than inventing a new mechanism. It is:
+ *   - id-type-aware ('patient_id' HP-* by default; 'ehr_id' resolves the roster to
+ *     openEHR ehr_ids so the 02-03 prescriptions ehr_id fallback keeps predicate +
+ *     roster the same id-type — review Item 2), and
+ *   - short-TTL per-org(+idType) cached so a list load does not pay a Demographics
+ *     round-trip on every page (review Item 3); the cache is keyed by the caller org
+ *     id so one org's roster can NEVER be served to another.
+ *
+ * `buildRosterMatchClause()` renders the roster as the AQL set-membership expression,
+ * mirroring the existing diagnosis `matches {…}` idiom (encounterService.ts:493). It
+ * fails CLOSED: an empty roster yields `matches {''}` (0 rows, never an absent/dropped
+ * predicate → never an unscoped read), and a roster larger than {@link ROSTER_MATCH_CAP}
+ * throws {@link RosterTooLargeError} — a loud refusal, never a truncated/oversized query.
+ *
+ * SECURITY: this module NEVER imports from the `@ehacare/bettercare-sdk` barrel (that
+ * would pull axios-interceptor side-effects and collide with the labs spec's SDK mock).
+ * The AQL id escaping is a small local mirror of the SDK's `sanitizeAQLParameter`
+ * (validation.ts:153-164); a parity unit test pins the mirror so it cannot drift.
+ */
+
+import * as sdkClientAdapter from '@services/sdkClientAdapter';
+import * as Sentry from '@sentry/nextjs';
+
+/**
+ * Hard cap on the number of ids interpolated into an AQL `matches {…}` set.
+ *
+ * WHY a fail-CLOSED cap and NOT chunk-and-merge: merging N separately
+ * LIMIT/OFFSET-paginated chunk queries cannot preserve a single global LIMIT/OFFSET
+ * without materializing the whole owned set app-side — the exact pagination-correctness
+ * defect that got the app-layer post-filter REJECTED in 02-RESEARCH § The Design Fork.
+ * So a roster over the cap must REFUSE loudly (typed error surfaced to the caller),
+ * never silently drop the predicate or truncate the roster. Prod is single-tenant per
+ * domain and dev/staging orgs are small, so this is a latent safety rail; its value is
+ * validated live in 02-03 Task 3.
+ */
+export const ROSTER_MATCH_CAP = 1000;
+
+/** Short TTL for the per-org roster cache (review Item 3). */
+const ROSTER_CACHE_TTL_MS = 5 * 60 * 1000;
+
+/** Page size requested from Demographics when fetching the complete roster. */
+const ROSTER_PAGE_SIZE = 1000;
+
+/**
+ * Encounter archetype patient-id path — the archetype whose HP-* Patient ID is known
+ * to resolve, used to translate an HP-* roster into openEHR ehr_ids ('ehr_id' mode).
+ * Mirrors getAllEncounters' SELECT/CONTAINS (encounterService.ts:191-246); re-confirmed
+ * live in 02-03 Task 2 where the prescriptions ehr_id fallback is exercised.
+ */
+const ENCOUNTER_PATIENT_ID_PATH =
+  "h/data[at0001]/items[at0007,'Patient ID']/value";
+
+export type RosterIdType = 'patient_id' | 'ehr_id';
+
+/**
+ * Thrown by {@link buildRosterMatchClause} when the roster exceeds
+ * {@link ROSTER_MATCH_CAP}. A fail-CLOSED refusal (carrying the observed `count` and
+ * the `cap`) — the caller surfaces it as an error; the AQL is NEVER emitted unscoped.
+ */
+export class RosterTooLargeError extends Error {
+  readonly count: number;
+  readonly cap: number;
+
+  constructor(count: number, cap: number) {
+    super(
+      `Org roster of ${count} patient ids exceeds the AQL match cap of ${cap}. ` +
+        `Refusing to emit an oversized/unscoped clinical-list query (fail-closed).`,
+    );
+    this.name = 'RosterTooLargeError';
+    this.count = count;
+    this.cap = cap;
+  }
+}
+
+/**
+ * Thrown by {@link fetchPatientIdRoster} when the org-scoped Demographics
+ * `searchPatients` call fails (M9, EHAC-1986). A DISTINGUISHABLE wrapper over the
+ * underlying cause so an on-call engineer can tell a Demographics/roster outage from an
+ * EHR/AQL-host failure — the clinical lists now depend on BOTH. Still fails closed via
+ * the caller's catch; the AQL is never emitted unscoped.
+ */
+export class RosterFetchError extends Error {
+  readonly cause: unknown;
+
+  constructor(cause: unknown) {
+    super(
+      'Failed to fetch the org patient roster from Demographics; clinical-list ' +
+        'tenant scoping cannot proceed (failing closed).',
+    );
+    this.name = 'RosterFetchError';
+    this.cause = cause;
+  }
+}
+
+interface RosterCacheEntry {
+  roster: string[];
+  expiresAt: number;
+}
+
+/** Module-level per-`<orgId>:<idType>` roster cache (never keyed without an org id). */
+const rosterCache = new Map<string, RosterCacheEntry>();
+
+/** Test-only: clear the module-level roster cache between cases. Not for production. */
+export function __resetRosterCacheForTests(): void {
+  rosterCache.clear();
+}
+
+/**
+ * Local mirror of the SDK's `sanitizeAQLParameter` (validation.ts:153-164):
+ * String(value), then replace `'` → `''`, strip `;` and `--`. Kept local to avoid the
+ * `@ehacare/bettercare-sdk` barrel/interceptor; a parity test pins it to the SDK fn.
+ */
+function escapeAqlLiteral(value: unknown): string {
+  if (value === null || value === undefined) {
+    return '';
+  }
+  return String(value).replace(/'/g, "''").replace(/;/g, '').replace(/--/g, '');
+}
+
+/**
+ * Reads the caller org id from the SDK session identity. Returns undefined when
+ * indeterminate (e.g. under a mock that does not expose it) so callers can fail safe
+ * and SKIP the cache rather than key one org's roster under an ambiguous value.
+ */
+function getCallerOrgId(): string | undefined {
+  // Guarded read: under a partial module mock that omits `getSDKTenantId`, accessing
+  // the export throws (vitest surfaces missing exports rather than returning undefined).
+  // Treat any indeterminate/absent identity as "skip the cache" (fail-safe) rather than
+  // keying a roster under an ambiguous value.
+  try {
+    const adapter = sdkClientAdapter as {
+      getSDKTenantId?: () => string | null | undefined;
+    };
+    const getId = adapter.getSDKTenantId;
+    if (typeof getId !== 'function') {
+      return undefined;
+    }
+    const id = getId();
+    return id ? id : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Fetches the caller org's COMPLETE HP-* patient roster from the org-scoped
+ * Demographics `searchPatients` leaf, paging until exhausted. Extracts each entry's
+ * `identifier[0].value` (mirror PatientList.tsx:183), drops falsy, de-duplicates.
+ * A thrown searchPatients error PROPAGATES (fail-visible, no silent empty roster).
+ */
+async function fetchPatientIdRoster(): Promise<string[]> {
+  const client = sdkClientAdapter.getSDKClientOrThrow();
+  const ids: string[] = [];
+  const seen = new Set<string>();
+  let offset = 0;
+
+  // Fetch the COMPLETE roster — a single page is expected for the confirmed dev org,
+  // but do not assume it (Pitfall 4: a partial roster silently drops the org's rows).
+  for (;;) {
+    let bundle: {
+      entry?: Array<{ resource?: { identifier?: Array<{ value?: string }> } }>;
+      total?: number;
+    };
+    try {
+      bundle = await client.demographics.patients.searchPatients({
+        active: 'true',
+        _count: ROSTER_PAGE_SIZE,
+        // H6 (EHAC-1986): send BOTH offset params. The Demographics server honours
+        // `_getpagesoffset`; the patient list hedges on exactly this (demography.ts:88-90).
+        // Sending only `_offset` risks a truncated first-page-only roster for large orgs.
+        // `_getpagesoffset` is not in the SDK's PatientSearchParams type (the patient list
+        // passes it via an `any` searchObj) — cast the literal through `unknown` rather than
+        // widening the whole call to `any`.
+        _getpagesoffset: offset,
+        _offset: offset,
+      } as unknown as Parameters<
+        typeof client.demographics.patients.searchPatients
+      >[0]);
+    } catch (error) {
+      // M9 (EHAC-1986): the clinical lists now hard-depend on Demographics. Make the
+      // coupling DISTINGUISHABLE — a breadcrumb + a typed RosterFetchError — so an on-call
+      // engineer sees "roster/Demographics", not a generic EHR/AQL failure, on propagation.
+      Sentry.addBreadcrumb({
+        category: 'tenant-roster',
+        level: 'error',
+        message:
+          'Demographics searchPatients failed while fetching the org roster; clinical lists fail closed.',
+      });
+      throw new RosterFetchError(error);
+    }
+
+    const entries = bundle?.entry ?? [];
+    for (const entry of entries) {
+      const id = entry?.resource?.identifier?.[0]?.value;
+      if (id && !seen.has(id)) {
+        seen.add(id);
+        ids.push(id);
+      }
+    }
+
+    // nit (EHAC-1986): once the roster passes ROSTER_MATCH_CAP, buildRosterMatchClause
+    // will throw RosterTooLargeError regardless — stop paging rather than fetch wasted pages.
+    if (ids.length > ROSTER_MATCH_CAP) {
+      break;
+    }
+
+    const total = typeof bundle?.total === 'number' ? bundle.total : undefined;
+    const gotFullPage = entries.length >= ROSTER_PAGE_SIZE;
+    const moreByTotal =
+      total !== undefined && ids.length < total && entries.length > 0;
+    if (entries.length === 0 || (!gotFullPage && !moreByTotal)) {
+      break;
+    }
+    offset += entries.length;
+  }
+
+  return ids;
+}
+
+/**
+ * Resolves an HP-* roster to distinct openEHR ehr_ids via ONE cap-guarded mapping AQL
+ * over the encounter archetype (review Item 2). Fail-CLOSED: an empty HP-* roster or a
+ * mapping error yields an empty ehr_id roster (→ downstream `matches {''}` → 0 rows),
+ * never an unscoped read. Returns null ONLY on a mapping error so the caller can avoid
+ * caching an errored result; [] means a legitimately-empty (cacheable) resolution.
+ */
+async function resolveEhrIdRoster(
+  patientRoster: string[],
+): Promise<string[] | null> {
+  if (patientRoster.length === 0) {
+    return [];
+  }
+  const client = sdkClientAdapter.getSDKClientOrThrow();
+  // Reuses buildRosterMatchClause, so the mapping AQL is ALSO cap-guarded.
+  const matchClause = buildRosterMatchClause(
+    ENCOUNTER_PATIENT_ID_PATH,
+    patientRoster,
+  );
+  const aql = `SELECT DISTINCT e/ehr_id/value AS Ehr_id
+      FROM EHR e
+      CONTAINS COMPOSITION c[openEHR-EHR-COMPOSITION.encounter.v1]
+      CONTAINS ADMIN_ENTRY h[openEHR-EHR-ADMIN_ENTRY.episode_institution.v0,'Patient Encounter']
+      WHERE ${matchClause}`;
+
+  try {
+    // executeRaw returns the server-native body verbatim (typed `unknown` by the SDK);
+    // read as `any` to preserve the prior loose response contract, as the list services do.
+    const data: any = await client.aql().executeRaw(aql, {});
+    const rows: Array<Record<string, unknown>> = data?.resultSet ?? [];
+    const seen = new Set<string>();
+    const ehrIds: string[] = [];
+    for (const row of rows) {
+      const cell = row?.Ehr_id as { value?: string } | string | undefined;
+      const value = typeof cell === 'object' ? cell?.value : cell;
+      if (value && !seen.has(value)) {
+        seen.add(value);
+        ehrIds.push(value);
+      }
+    }
+    return ehrIds;
+  } catch {
+    // fail-CLOSED: an unresolvable mapping must never proceed unscoped.
+    return null;
+  }
+}
+
+/**
+ * Returns the caller org's complete roster of ids, id-type-aware and short-TTL
+ * per-org cached. Mirrors the patient-list org scoping (Key Decision #2) and is the
+ * roster SOURCE for the clinical-list `matches {…}` predicate.
+ *
+ * @param idType 'patient_id' (default) → HP-* identifier values; 'ehr_id' → openEHR
+ *   ehr_ids resolved via a cap-guarded mapping AQL (review Item 2, for the 02-03
+ *   prescriptions fallback).
+ * @param options.forceRefresh (H4, EHAC-1986) bypass the cache and re-fetch. A by-id
+ *   guard that missed a possibly-stale cached roster (e.g. a just-registered patient whose
+ *   row is not yet in a ≤5-min-old cache) retries once with this set, so it never wrongly
+ *   refuses an owned record. Still fail-closed — a fresh fetch, never an unscoped read.
+ */
+export async function getOrgPatientRoster(
+  idType: RosterIdType = 'patient_id',
+  options?: { forceRefresh?: boolean },
+): Promise<string[]> {
+  const orgId = getCallerOrgId();
+  const cacheKey = orgId ? `${orgId}:${idType}` : undefined;
+
+  if (cacheKey && !options?.forceRefresh) {
+    const cached = rosterCache.get(cacheKey);
+    if (cached && cached.expiresAt > Date.now()) {
+      return cached.roster;
+    }
+  }
+
+  // searchPatients errors propagate here (never cached — the try/catch is the caller's).
+  const patientRoster = await fetchPatientIdRoster();
+
+  let roster: string[];
+  if (idType === 'ehr_id') {
+    const resolved = await resolveEhrIdRoster(patientRoster);
+    if (resolved === null) {
+      // fail-CLOSED mapping error: return an empty (0-row) roster WITHOUT caching it.
+      return [];
+    }
+    roster = resolved;
+  } else {
+    roster = patientRoster;
+  }
+
+  // Cache only a successful complete resolution, and only under a known org key.
+  if (cacheKey) {
+    rosterCache.set(cacheKey, {
+      roster,
+      expiresAt: Date.now() + ROSTER_CACHE_TTL_MS,
+    });
+  }
+  return roster;
+}
+
+/**
+ * Renders the AQL set-membership expression `idPath matches { '<id>', … }` with each id
+ * escaped by the local sanitizer (mirrors the diagnosis idiom, encounterService.ts:531-544).
+ * The returned expression carries NO leading `WHERE`/`and` — each caller composes it into
+ * its own WHERE with the correct connective.
+ *
+ * Fail-CLOSED semantics:
+ *  - an empty roster deliberately returns `idPath matches {''}` (matches no real id → 0
+ *    rows: a 0-patient org sees nothing) rather than dropping the predicate, and
+ *  - a roster over {@link ROSTER_MATCH_CAP} throws {@link RosterTooLargeError} (a loud
+ *    refusal) rather than emitting an oversized/truncated query.
+ */
+export function buildRosterMatchClause(
+  idPath: string,
+  roster: string[],
+): string {
+  if (roster.length > ROSTER_MATCH_CAP) {
+    throw new RosterTooLargeError(roster.length, ROSTER_MATCH_CAP);
+  }
+  if (roster.length === 0) {
+    return `${idPath} matches {''}`;
+  }
+  const set = roster.map((id) => `'${escapeAqlLiteral(id)}'`).join(',');
+  return `${idPath} matches { ${set} }`;
+}
diff --git a/e2e/bettercare/tests/clinical-list-tenant-isolation.spec.ts b/e2e/bettercare/tests/clinical-list-tenant-isolation.spec.ts
new file mode 100644
index 0000000000..7f7bced6e7
--- /dev/null
+++ b/e2e/bettercare/tests/clinical-list-tenant-isolation.spec.ts
@@ -0,0 +1,448 @@
+import { test, expect } from '@playwright/test';
+import { ApiHelper } from '../../shared/helpers/api-helper';
+import { FhirHelper } from '../helpers/fhir-helper';
+import { decodeJwtPayload } from '../../shared/helpers/jwt';
+import { assertEnvVar } from '../../shared/helpers/preflight-assertions';
+
+/**
+ * Clinical-list Tenant Isolation — LIVE server-scoping oracle (EHAC-1986, REPRO-01)
+ * ================================================================================
+ *
+ * WHAT THIS PROVES (and what it does NOT)
+ * ---------------------------------------
+ * This is the **live** oracle for the intra-domain PHI leak on the three clinical
+ * lists (`/encounters`, `/labtests`, `/prescriptions`). The count-vs-roster probes
+ * assert the leak EXISTS on the DEPLOYED server (distinctCount > rosterSize) — they
+ * query the raw openEHR AQL host directly, so an APP-LAYER fix does NOT change their
+ * result and they stay red until the fix is deployed AND per-org ehr_domain scoping
+ * lands server-side (M11 review: the fix does NOT "invert" these assertions). The
+ * separate operator-gated by-id probe below IS a passing isolation assertion — it
+ * builds the fix's own roster-scoped by-id AQL and asserts 0 rows for a foreign id.
+ *
+ * Contrast (Landmine B): the Wave-1 Vitest specs
+ * (`encounterService.isolation.test.ts`, `labOrders.isolation.test.ts`,
+ * `prescriptionService.isolation.test.ts`) stub `executeRaw`, so they can only prove
+ * **app-layer** behavior (the service returns the resultSet verbatim, unfiltered).
+ * They cannot prove the **server** returns cross-tenant rows. THIS spec exercises the
+ * real openEHR AQL server with a real token, so it is the only artifact that observes
+ * the server-side scoping gap.
+ *
+ * SINGLE-TOKEN, INTRA-DOMAIN (Landmine A — the false-green trap)
+ * -------------------------------------------------------------
+ * The leak is INTRA-`ehr_domain` (Plan 01-02, A1 CONFIRMED: multiple KC orgs resolve
+ * to the shared `eha-clinics` `ehr_domain`). We therefore use a SINGLE `eha-clinics`
+ * principal and compare that org's own Demographics roster against the distinct
+ * patients its clinical-list AQL returns. We do NOT pair `eha-clinics` vs `newtenant`
+ * — those live in DIFFERENT `ehr_domain`s and are already isolated (proven green by
+ * `ehr-tenant-isolation.spec.ts`), so that pairing would FALSE-GREEN.
+ *
+ * THE ORACLE
+ * ----------
+ * 1. Fetch the org roster DYNAMICALLY from the org-scoped Demographics (FHIR) host —
+ *    the same isolating source the patient list uses (`demography.ts:52-55`,
+ *    `attachTenantHeader=false`, org scope from the OAuth token). `rosterSize` is read
+ *    at runtime; there is NO hardcoded patient-count magic number (Review Item 1).
+ * 2. For each clinical AQL, FIRST assert a FLOOR (`>= 1` distinct patient) BEFORE the
+ *    cardinality check. An empty result set is trivially "a subset of any roster", so a
+ *    down server / bad filter / broken query would otherwise FALSE-GREEN as isolated.
+ *    The floor makes an empty result FAIL loudly (Review Item 1).
+ * 3. Then assert the distinct clinical-list patient count EXCEEDS `rosterSize` — the
+ *    leak. Because the clinical AQL is held to the SAME branch the org operates in
+ *    (see PROBE_BRANCH) while the roster spans ALL the org's branches, a branch-scoped
+ *    clinical set exceeding the org-wide roster proves branch CANNOT explain the
+ *    asymmetry (Landmine D / Pitfall 4).
+ *
+ * PHI HYGIENE (ASVS V7, Review Item 4)
+ * ------------------------------------
+ * The live AQL returns real PHI. Only AGGREGATE counts and NON-REVERSIBLE MASKED
+ * identifiers (`maskId` -> `abcd***`) are ever logged. Raw patient ids/names are never
+ * emitted to `console`, `test.step`, or Playwright traces.
+ *
+ * OPERATOR-GATED / not the phase gate
+ * -----------------------------------
+ * This spec requires live `dev-app.eha.care` creds (ROPC via `BETTERCARE_CLIENT_SECRET`
+ * + `FHIR_BASE_URL`/EHR host). It runs as CONFIRMATION, not as the deterministic gate
+ * (the Vitest specs are the gate). The live count-vs-roster reproduction was already
+ * performed manually in Plan 01-02 (50 encounters spanning 15+ patients vs a ~2–3
+ * patient org footprint).
+ *
+ * FOLLOW-UP (Phase 4 regression guard, shareable with adr-008 EHAC-1796)
+ * ---------------------------------------------------------------------
+ * A genuine SECOND same-`ehr_domain` org is NOT wired into the harness today — the
+ * `ApiHelper`/`FhirHelper` tenant union is only `'eha-clinics' | 'newtenant'` (and
+ * `newtenant` is a different domain). Extending the harness to a real second
+ * same-domain org (so the guard can assert cross-org invisibility directly, rather
+ * than via count-vs-roster) is the Phase-4 follow-up.
+ */
+
+/**
+ * Branch held constant across the org's own rows and the leaked rows (Landmine D).
+ * Default = the branch observed in Plan 01-02 live evidence, where the org's own DRAFT
+ * encounters (EN228001 / EN228000 / EN228000L) sit. Encounters filter by branch NAME;
+ * labs and prescriptions filter by branch CODE. When a value is empty the corresponding
+ * clinical AQL runs domain-wide (a SUPERSET — the leak still holds a fortiori); supply
+ * `EHAC1986_PROBE_BRANCH_CODE` to hold the labs/prescriptions probes to the same branch.
+ */
+const PROBE_BRANCH = {
+  name: process.env.EHAC1986_PROBE_BRANCH_NAME ?? 'Kano - Lamido Crescent',
+  code: process.env.EHAC1986_PROBE_BRANCH_CODE ?? '',
+};
+
+/** Escape single quotes for safe inlining of an operator-supplied branch literal. */
+const escapeAql = (value: string): string => value.replace(/'/g, "''");
+
+/** Non-reversible mask for any PHI identifier that must appear in output (ASVS V7). */
+function maskId(value: unknown): string {
+  const s = cellValue(value);
+  if (!s) return '∅';
+  return s.length <= 4 ? '***' : `${s.slice(0, 4)}***`;
+}
+
+/**
+ * openEHR AQL cells arrive either as a bare scalar or as a `{ value: ... }` wrapper
+ * (e.g. `Patient_id: { value: 'HP-EHAC-001' }`). Normalize to a string identifier.
+ */
+function cellValue(cell: unknown): string | undefined {
+  if (cell == null) return undefined;
+  if (typeof cell === 'string') return cell;
+  if (typeof cell === 'number') return String(cell);
+  if (typeof cell === 'object') {
+    const v = (cell as Record<string, unknown>).value;
+    return v == null ? undefined : String(v);
+  }
+  return undefined;
+}
+
+type AqlRow = Record<string, unknown>;
+
+interface ClinicalListProbe {
+  /** Human label used in the test title (never carries PHI). */
+  label: string;
+  /** The live AQL — mirrors the service's composition archetype + branch predicate. */
+  aql: string;
+  /** Column carrying the list-specific patient identifier (for the identity leak). */
+  identifierColumn: string;
+  /**
+   * Whether the list's SELECT exposes a stable Patient id column. Prescriptions do NOT
+   * (`getPrescriptionReport` selects `Patient_name`, not `Patient_id` —
+   * prescriptionService.ts:205-220), so a Phase-2 roster post-filter needs an added
+   * `Patient_id` SELECT column or ehr_id-based scoping. Recorded here as a live caveat.
+   */
+  hasPatientIdColumn: boolean;
+}
+
+const encounterBranchClause = PROBE_BRANCH.name
+  ? `WHERE h/data[at0001]/items[at0018]/items[openEHR-EHR-CLUSTER.organisation.v1,'Facility']/items[at0001]/value = '${escapeAql(PROBE_BRANCH.name)}'`
+  : '';
+
+const labBranchClause = PROBE_BRANCH.code
+  ? `WHERE g/items[at0010]/value = '${escapeAql(PROBE_BRANCH.code)}'`
+  : '';
+
+const prescriptionBranchClause = PROBE_BRANCH.code
+  ? `WHERE c/context/other_context[at0001]/items[at0019]/value = '${escapeAql(PROBE_BRANCH.code)}'`
+  : '';
+
+/**
+ * The three clinical-list AQL shapes, faithful to the service builders:
+ *  - encounters:    encounterService.ts:238-243 (encounter.v1), Patient id at
+ *                   h/data[at0001]/items[at0007]; branch at .../items[at0018] Facility.
+ *  - labs:          labOrders.ts:170-172 (report-result.v1 + laboratory_test_result.v1),
+ *                   Patient_ID at g/items[at0006]; branch code at g/items[at0010].
+ *  - prescriptions: prescriptionService.ts:221-223 (prescription.v0), Patient_name at
+ *                   c/context/other_context[at0001]/items[at0014] (NO Patient_id column);
+ *                   branch code at .../items[at0019].
+ * Every probe additionally selects `e/ehr_id/value AS Ehr_id` — the uniform,
+ * always-present patient-level key used for the distinct-patient CARDINALITY oracle.
+ */
+const CLINICAL_LIST_PROBES: ClinicalListProbe[] = [
+  {
+    label: 'encounters (/encounters — encounter.v1)',
+    identifierColumn: 'Patient_id',
+    hasPatientIdColumn: true,
+    aql: `SELECT DISTINCT e/ehr_id/value AS Ehr_id,
+        h/data[at0001]/items[at0007,'Patient ID']/value AS Patient_id
+      FROM EHR e
+      CONTAINS COMPOSITION c[openEHR-EHR-COMPOSITION.encounter.v1]
+      CONTAINS ADMIN_ENTRY h[openEHR-EHR-ADMIN_ENTRY.episode_institution.v0,'Patient Encounter']
+      ${encounterBranchClause}`,
+  },
+  {
+    label: 'lab tests (/labtests — report-result.v1)',
+    identifierColumn: 'Patient_ID',
+    hasPatientIdColumn: true,
+    aql: `SELECT DISTINCT e/ehr_id/value AS Ehr_id,
+        g/items[at0006]/value AS Patient_ID
+      FROM EHR e
+      CONTAINS COMPOSITION c[openEHR-EHR-COMPOSITION.report-result.v1]
+      CONTAINS (CLUSTER g[openEHR-EHR-CLUSTER.encounter_id.v0] and OBSERVATION x[openEHR-EHR-OBSERVATION.laboratory_test_result.v1])
+      ${labBranchClause}`,
+  },
+  {
+    label: 'prescriptions (/prescriptions — prescription.v0, NO Patient_id column)',
+    identifierColumn: 'Patient_name',
+    hasPatientIdColumn: false,
+    aql: `SELECT DISTINCT e/ehr_id/value AS Ehr_id,
+        c/context/other_context[at0001]/items[at0014]/value AS Patient_name
+      FROM EHR e
+      CONTAINS COMPOSITION c[openEHR-EHR-COMPOSITION.prescription.v0]
+      ${prescriptionBranchClause}`,
+  },
+];
+
+/**
+ * OPERATOR-GATED BY-ID ISOLATION PROBE (EHAC-1986, DETAIL-01 — Phase 3 live confirmation)
+ * ======================================================================================
+ * The Vitest specs (encounter/labOrders/prescription isolation + aql) are the DETERMINISTIC
+ * gate proving the 03-02 by-id fix at the app layer. THIS probe is the LIVE confirmation:
+ * a synthetic FOREIGN sentinel id (an id belonging to ANOTHER org in the SAME `eha-clinics`
+ * ehr_domain) is run through BOTH (a) an UNSCOPED by-id AQL — expected to still resolve the
+ * cross-tenant record (`>= 1` distinct patient; a 0 means a bad/own sentinel → fail loudly)
+ * and (b) the ROSTER-SCOPED by-id AQL that 03-02 shipped — expected to return `0` rows (the
+ * fix refuses the foreign id, 404-style natural-empty).
+ *
+ * OPERATOR-GATED: each domain's sentinel is read from env via assertEnvVar, which fails loud
+ * when absent (zero-skip policy — never a silent skip, never a hardcoded real id in the spec).
+ * Runs only with live creds + sentinel.
+ * PHI HYGIENE (ASVS V7): only masked ids + aggregate counts are logged; sentinels are synthetic.
+ */
+interface ByIdProbe {
+  /** Human label used in the test title (never carries PHI). */
+  label: string;
+  /** Env var carrying a SYNTHETIC foreign sentinel id (operator-supplied). */
+  sentinelEnv: string;
+  /** Record-id key path used in the by-id WHERE (mirrors the fixed service). */
+  idKey: string;
+  /** Per-domain patient-id path the roster `matches {roster}` clause scopes on. */
+  patientIdPath: string;
+  /** FROM ... CONTAINS ... faithful to the service composition archetype. */
+  fromContains: string;
+  /** SELECT alias for the patient identifier (masked in logs, never raw). */
+  identifierColumn: string;
+}
+
+/**
+ * The three by-id shapes, faithful to the 03-02-scoped services:
+ *  - encounters:    getEncounter — encounter.v1, id key items[at0014,'Encounter ID']/value/id,
+ *                   patient path items[at0007,'Patient ID']/value (encounterService.ts).
+ *  - labs:          getLabOrderByReportId — report-result.v1, report_id key
+ *                   c/context/other_context[at0001]/items[at0002]/value, patient path
+ *                   g/items[at0006]/value (labOrders.ts).
+ *  - prescriptions: getPrescriptionById — prescription.v0, id key
+ *                   c/context/other_context[at0001]/items[at0008]/value/id, patient path
+ *                   l/items[at0006]/value (prescriptionService.ts).
+ */
+const BY_ID_PROBES: ByIdProbe[] = [
+  {
+    label: 'encounters (getEncounter — encounter.v1 by Encounter ID)',
+    sentinelEnv: 'EHAC1986_FOREIGN_SENTINEL_ENCOUNTER_ID',
+    idKey: "h/data[at0001]/items[at0014,'Encounter ID']/value/id",
+    patientIdPath: "h/data[at0001]/items[at0007,'Patient ID']/value",
+    identifierColumn: 'Patient_id',
+    fromContains: `FROM EHR e
+      CONTAINS COMPOSITION c[openEHR-EHR-COMPOSITION.encounter.v1]
+      CONTAINS ADMIN_ENTRY h[openEHR-EHR-ADMIN_ENTRY.episode_institution.v0,'Patient Encounter']`,
+  },
+  {
+    label: 'lab tests (getLabOrderByReportId — report-result.v1 by report_id)',
+    sentinelEnv: 'EHAC1986_FOREIGN_SENTINEL_LAB_REPORT_ID',
+    idKey: 'c/context/other_context[at0001]/items[at0002]/value',
+    patientIdPath: 'g/items[at0006]/value',
+    identifierColumn: 'Patient_ID',
+    fromContains: `FROM EHR e
+      CONTAINS COMPOSITION c[openEHR-EHR-COMPOSITION.report-result.v1]
+      CONTAINS (CLUSTER g[openEHR-EHR-CLUSTER.encounter_id.v0] and OBSERVATION x[openEHR-EHR-OBSERVATION.laboratory_test_result.v1])`,
+  },
+  {
+    label: 'prescriptions (getPrescriptionById — prescription.v0 by Prescription id)',
+    sentinelEnv: 'EHAC1986_FOREIGN_SENTINEL_PRESCRIPTION_ID',
+    idKey: 'c/context/other_context[at0001]/items[at0008]/value/id',
+    patientIdPath: 'l/items[at0006]/value',
+    identifierColumn: 'Patient_id',
+    fromContains: `FROM EHR e
+      CONTAINS COMPOSITION c[openEHR-EHR-COMPOSITION.prescription.v0]
+      CONTAINS CLUSTER l[openEHR-EHR-CLUSTER.encounter_id.v0]`,
+  },
+];
+
+/**
+ * Render a fail-closed `<path> matches { 'a', 'b', ... }` clause from the live roster —
+ * mirrors the app's `buildRosterMatchClause` semantics (tenantRoster.ts). An empty roster
+ * fails CLOSED to `matches { '' }` (0 rows), never an unscoped read. Each id is escaped.
+ */
+function rosterMatchClause(path: string, ids: Iterable<string>): string {
+  const literals = [...ids].map((id) => `'${escapeAql(id)}'`);
+  const set = literals.length ? literals.join(', ') : "''";
+  return `${path} matches { ${set} }`;
+}
+
+test.describe('Clinical-list tenant isolation — live leak oracle (EHAC-1986)', () => {
+  let api: ApiHelper;
+  let ehrDomain: string | undefined;
+  let rosterSize = 0;
+  // Hoisted to describe scope so the operator-gated by-id probe (below) can build the
+  // roster-scoped `matches {roster}` clause from the SAME live roster the count-vs-roster
+  // oracle uses. Populated once in beforeAll.
+  const rosterIds = new Set<string>();
+
+  test.beforeAll(async () => {
+    // SINGLE eha-clinics principal — the clinical AQL reader.
+    api = await ApiHelper.create({ tenant: 'eha-clinics', role: 'doctor' });
+
+    // Premise (A1): confirm the token's ehr_domain so the intra-domain framing holds.
+    const claims = decodeJwtPayload(api.getAccessToken());
+    ehrDomain =
+      typeof claims?.ehr_domain === 'string' ? claims.ehr_domain : undefined;
+    console.info(
+      `[clinical-list-isolation] token ehr_domain = ${ehrDomain ?? 'UNKNOWN'} (A1 expects 'eha-clinics')`,
+    );
+
+    // Roster baseline — org-scoped Demographics (FHIR), SAME org principal.
+    // Org scope travels in the OAuth token, so this Bundle IS the org's roster.
+    const fhir = await FhirHelper.create({ tenant: 'eha-clinics', role: 'doctor' });
+    const bundle = await fhir.searchPatients({ _count: '1000' });
+    for (const entry of bundle.entry ?? []) {
+      // BLOCKER 2 (review): key the roster on the HP-* Patient identifier, NOT the FHIR
+      // logical resource id (a UUID). The by-id probe feeds rosterIds to a Patient-ID-path
+      // `matches {…}`, and the shipped fetchPatientIdRoster uses `identifier[0].value` — matching
+      // a UUID against the HP-* path returns 0 rows unconditionally, making the by-id probe vacuous.
+      const id = (entry.resource as fhir4.Patient | undefined)?.identifier?.[0]
+        ?.value;
+      if (id) rosterIds.add(id);
+    }
+    rosterSize = rosterIds.size;
+    console.info(
+      `[clinical-list-isolation] org Demographics roster size = ${rosterSize} (dynamic; NOT hardcoded)`,
+    );
+  });
+
+  test('intra-domain premise: token resolves to the shared eha-clinics ehr_domain (A1)', () => {
+    // Guards the reproduction framing: if the token were on its OWN domain the leak
+    // would be a provisioning bug, not an app-layer roster-scoping gap (SC#3).
+    expect(ehrDomain, 'token must carry an ehr_domain claim').toBeTruthy();
+    expect(ehrDomain).toBe('eha-clinics');
+  });
+
+  test('org Demographics roster is non-empty (baseline sanity floor)', () => {
+    // A zero roster would let any clinical count "exceed" it and false-green the leak.
+    expect(
+      rosterSize,
+      'org roster must be >= 1 or the count-vs-roster oracle is meaningless',
+    ).toBeGreaterThanOrEqual(1);
+  });
+
+  for (const probe of CLINICAL_LIST_PROBES) {
+    test(`LEAKS today: ${probe.label} returns more distinct patients than the org roster`, async () => {
+      const result = (await api.queryAql(probe.aql)) as {
+        resultSet?: AqlRow[];
+      };
+      const rows = result.resultSet ?? [];
+
+      // Distinct patients keyed on the uniform ehr_id column.
+      const distinctPatients = new Set<string>();
+      const leakedIdentifiers: string[] = [];
+      for (const row of rows) {
+        const ehrId = cellValue(row.Ehr_id);
+        if (ehrId) distinctPatients.add(ehrId);
+        const identifier = row[probe.identifierColumn];
+        if (identifier != null) leakedIdentifiers.push(maskId(identifier));
+      }
+      const distinctCount = distinctPatients.size;
+
+      // Masked, aggregate-only diagnostics (ASVS V7).
+      console.info(
+        `[clinical-list-isolation] ${probe.label}: rows=${rows.length}, ` +
+          `distinctPatients=${distinctCount}, rosterSize=${rosterSize}, ` +
+          `hasPatientIdColumn=${probe.hasPatientIdColumn}, ` +
+          `sampleMaskedIds=${leakedIdentifiers.slice(0, 5).join(',') || '∅'}`,
+      );
+
+      // FLOOR FIRST (Review Item 1): an empty/failed query must FAIL, not pass as
+      // "isolated". Only after clearing the floor is the cardinality check meaningful.
+      expect(
+        distinctCount,
+        'floor: clinical AQL must return >= 1 distinct patient (empty result would false-green as isolated)',
+      ).toBeGreaterThanOrEqual(1);
+
+      // THE LEAK (RED until Phase 2): the branch-scoped clinical list surfaces MORE
+      // distinct patients than the org's entire (all-branch) Demographics roster.
+      // Phase 2's fix makes distinctCount <= rosterSize (roster-subset holds) and
+      // inverts this assertion into the passing isolation guard.
+      expect(
+        distinctCount,
+        'LEAK: clinical-list distinct patients must exceed the org roster (intra-domain leak; Phase 2 inverts this)',
+      ).toBeGreaterThan(rosterSize);
+    });
+  }
+
+  // ── Operator-gated by-id isolation probe (DETAIL-01 live confirmation) ──────────────
+  // For each domain with a synthetic foreign sentinel env, assert the UNSCOPED by-id AQL
+  // still resolves the cross-tenant record (>= 1 distinct patient — proof the sentinel is
+  // a genuine foreign leak target) while the ROSTER-SCOPED by-id AQL (the 03-02 fix shape)
+  // returns 0 rows (the foreign id is refused). Fails loud (assertEnvVar) per-domain when the
+  // sentinel is absent — zero-skip policy: an operator-gated check that cannot run fails, never skips.
+  for (const probe of BY_ID_PROBES) {
+    test(`by-id refusal: foreign ${probe.label} sentinel returns 0 rows under the roster-scoped query`, async () => {
+      // Operator-gated: supply a synthetic foreign sentinel id (an id owned by another org in the
+      // same eha-clinics ehr_domain). assertEnvVar fails loud if unset (zero-skip compliance).
+      const resolvedSentinel = assertEnvVar(probe.sentinelEnv);
+      const escapedSentinel = escapeAql(resolvedSentinel);
+      const selectHead =
+        `SELECT DISTINCT e/ehr_id/value AS Ehr_id,\n        ` +
+        `${probe.patientIdPath} AS ${probe.identifierColumn}`;
+      const unscopedAql =
+        `${selectHead}\n      ${probe.fromContains}\n      ` +
+        `WHERE ${probe.idKey} = '${escapedSentinel}'`;
+      const scopedAql =
+        `${selectHead}\n      ${probe.fromContains}\n      ` +
+        `WHERE ${probe.idKey} = '${escapedSentinel}' and ` +
+        `${rosterMatchClause(probe.patientIdPath, rosterIds)}`;
+
+      const distinctPatients = (rows: AqlRow[]): number => {
+        const set = new Set<string>();
+        for (const row of rows) {
+          const ehrId = cellValue(row.Ehr_id);
+          if (ehrId) set.add(ehrId);
+        }
+        return set.size;
+      };
+
+      const unscoped = (await api.queryAql(unscopedAql)) as {
+        resultSet?: AqlRow[];
+      };
+      const scoped = (await api.queryAql(scopedAql)) as {
+        resultSet?: AqlRow[];
+      };
+      const unscopedRows = unscoped.resultSet ?? [];
+      const scopedRows = scoped.resultSet ?? [];
+      const unscopedDistinct = distinctPatients(unscopedRows);
+
+      // Masked, aggregate-only diagnostics (ASVS V7). The sentinel is synthetic; its owner
+      // patient id is never emitted — only the count and a masked sample.
+      const maskedSample = unscopedRows
+        .map((row) => maskId(row[probe.identifierColumn]))
+        .slice(0, 3)
+        .join(',');
+      console.info(
+        `[clinical-list-isolation] by-id ${probe.label}: sentinel=${maskId(resolvedSentinel)}, ` +
+          `unscopedRows=${unscopedRows.length}, unscopedDistinctPatients=${unscopedDistinct}, ` +
+          `scopedRows=${scopedRows.length}, rosterSize=${rosterSize}, ` +
+          `sampleMaskedIds=${maskedSample || '∅'}`,
+      );
+
+      // (a) The sentinel must be a GENUINE cross-tenant leak target: unscoped it resolves
+      // to >= 1 distinct patient. A 0 here means a bad/own sentinel — fail loudly, don't
+      // let it false-green the refusal below.
+      expect(
+        unscopedDistinct,
+        'sentinel must exist cross-tenant (>= 1 distinct patient unscoped); a 0 means a bad/own sentinel',
+      ).toBeGreaterThanOrEqual(1);
+
+      // (b) THE FIX: the roster-scoped by-id query refuses the foreign sentinel → 0 rows.
+      expect(
+        scopedRows.length,
+        'roster-scoped by-id must refuse the foreign sentinel (0 rows — the 03-02 fix)',
+      ).toBe(0);
+    });
+  }
+});
